# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
apps/runner/bin/
apps/web/dist/

# Test / coverage
coverage/
.vitest/
tests/tmp/

# Local toolchains fetched by scripts
.toolchain/

# Python bytecode cache (scripts/lib has a couple of .py helpers)
__pycache__/
*.pyc

# -----------------------------------------------------------------------------
# SECRETS — never commit. Only *.example files belong in this repository.
# -----------------------------------------------------------------------------
secrets/
*.secret
*.key
!*.key.example
.env
.env.*
!.env.example
!*.env.example
rclone.conf
!rclone.conf.example
*.pem
*.p12
*.pfx

# Runtime artifacts
*.log
logs/
*.sock

# Generated, host-specific reports (preflight, etc.) — never commit; these
# capture real local paths, hostnames and network details for this host.
reports/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
