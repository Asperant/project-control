# =============================================================================
# Project Control — Version Lock
# =============================================================================
# Every container image is pinned to an immutable manifest digest that was
# resolved from the official upstream registry (registry-1.docker.io) on the
# date recorded below. Tags are retained ONLY as human-readable annotations;
# all runtime references MUST use the digest.
#
# Do NOT use `latest`, floating tags, or version ranges here.
# Regenerate with: ./pcctl update   (writes a backup copy first)
# Verify with:     ./scripts/verify-image-digests.sh
# -----------------------------------------------------------------------------
# Resolution date : 2026-08-04
# Resolution host : linux/amd64
# Resolution tool : docker buildx imagetools inspect --format {{.Manifest.Digest}}
# Digest type     : OCI image index / manifest list (multi-arch)
# =============================================================================

PC_VERSIONS_LOCK_SCHEMA=1
PC_VERSIONS_LOCK_RESOLVED_AT=2026-08-04
PC_VERSIONS_LOCK_PLATFORM=linux/amd64

# -----------------------------------------------------------------------------
# PostgreSQL — single instance hosting both `project_control` and `n8n` databases
# -----------------------------------------------------------------------------
# 17.10 is chosen over 18.x deliberately: it is the newest PostgreSQL major that
# the pinned n8n release (2.34.0) is known to run against in production. See
# docs/architecture.md ("Version selection rationale").
PC_POSTGRES_TAG=17.10-trixie
PC_POSTGRES_DIGEST=sha256:a426e44bac0b759c95894d68e1a0ac03ecc20b619f498a91aae373bf06d8508d
PC_POSTGRES_IMAGE=postgres@sha256:a426e44bac0b759c95894d68e1a0ac03ecc20b619f498a91aae373bf06d8508d
PC_POSTGRES_VERSION=17.10
PC_POSTGRES_UID=999
PC_POSTGRES_GID=999

# -----------------------------------------------------------------------------
# n8n — automation engine (PostgreSQL-backed, no SQLite)
# -----------------------------------------------------------------------------
# Explicit release tag, NOT `stable` (which floats across the 1.x/2.x lines).
PC_N8N_TAG=2.34.0
PC_N8N_DIGEST=sha256:d92b370360f8af2ea8ea344d3fd70853a575a7afb568472930c82cd138fe0757
PC_N8N_IMAGE=n8nio/n8n@sha256:d92b370360f8af2ea8ea344d3fd70853a575a7afb568472930c82cd138fe0757
PC_N8N_VERSION=2.34.0
PC_N8N_UID=1000
PC_N8N_GID=1000

# -----------------------------------------------------------------------------
# Caddy — local-only reverse proxy (edge) and static file server (web)
# -----------------------------------------------------------------------------
PC_CADDY_TAG=2.11.4-alpine
PC_CADDY_DIGEST=sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
PC_CADDY_IMAGE=caddy@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
PC_CADDY_VERSION=2.11.4

# -----------------------------------------------------------------------------
# Node.js — build + runtime base for control-api and web build stage
# -----------------------------------------------------------------------------
PC_NODE_BUILD_TAG=24.19.0-trixie
PC_NODE_BUILD_DIGEST=sha256:ef91212c27702eab90248892b1ac837ba3e903f78385770bd11f7c460e28eaf7
PC_NODE_BUILD_IMAGE=node@sha256:ef91212c27702eab90248892b1ac837ba3e903f78385770bd11f7c460e28eaf7

PC_NODE_RUNTIME_TAG=24.19.0-trixie-slim
PC_NODE_RUNTIME_DIGEST=sha256:85498d7fd8e2bc0b02abb1792ef27341559836236dd0b1af160fa66bb85148df
PC_NODE_RUNTIME_IMAGE=node@sha256:85498d7fd8e2bc0b02abb1792ef27341559836236dd0b1af160fa66bb85148df

PC_NODE_VERSION=24.19.0

# -----------------------------------------------------------------------------
# Locally built images (built from this repository, never pulled)
# -----------------------------------------------------------------------------
PC_CONTROL_API_IMAGE=project-control/control-api:1.0.0
PC_WEB_IMAGE=project-control/web:1.0.0
# Thin layer over PC_CADDY_IMAGE that strips the binary's cap_net_bind_service
# file capability, without which the container cannot exec under cap_drop: ALL.
# See infra/caddy/Dockerfile.
PC_CADDY_PROXY_IMAGE=project-control/caddy:1.0.0
PC_STACK_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Host toolchain pins (used by build + install scripts)
# -----------------------------------------------------------------------------
# Go toolchain used to produce the static runner binary.
PC_GO_VERSION=1.26.5
PC_GO_SHA256=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053
PC_GO_TARBALL=go1.26.5.linux-amd64.tar.gz

# pnpm is pinned via the root package.json `packageManager` field as well.
PC_PNPM_VERSION=11.15.0

# -----------------------------------------------------------------------------
# Fixed UID/GID map — keeps bind-mount ownership deterministic across rebuilds
# -----------------------------------------------------------------------------
PC_APP_UID=10001              # control-api container user
PC_APP_GID=10001              # control-api container group
PC_CONTROL_GID=10002          # host group `project-control`; owns runner.sock
PC_RUNNER_USER=project-runner # host system user running the Go runner
PC_WEB_UID=10003              # web (static file server) container user

# -----------------------------------------------------------------------------
# Host backup tooling
# -----------------------------------------------------------------------------
# Installed from upstream release binaries with the checksums below, NOT from
# the Ubuntu 22.04 archive. Rationale: jammy ships restic 0.12.1 (2021), which
# is four years and several data-integrity fixes behind. For the component whose
# entire job is being correct about your last-resort copy of the data, running a
# four-year-old build is the wrong trade. rclone is likewise far newer upstream.
#
# These were not previously pinned at all; this adds a pin rather than changing
# an existing one.
PC_RESTIC_VERSION=0.19.1
PC_RESTIC_SHA256=f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c
PC_RESTIC_ASSET=restic_0.19.1_linux_amd64.bz2

PC_RCLONE_VERSION=1.75.0
PC_RCLONE_SHA256=aa2804e08f48250e71009c727124b6341cd0288465804a9a09d14663cabafbaa
PC_RCLONE_ASSET=rclone-v1.75.0-linux-amd64.zip

# Tailscale is installed from the official apt repository, which is signed and
# tracks the stable channel. Version at the time of writing:
PC_TAILSCALE_VERSION_AT_WRITING=1.102.1
