{
  "name": "@project-control/control-api",
  "version": "1.0.0",
  "private": true,
  "description": "Project Control — Control API (Fastify + PostgreSQL)",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node dist/cli/migrate.js",
    "create-admin": "node dist/cli/create-admin.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@node-rs/argon2": "2.0.2",
    "@project-control/contracts": "workspace:*",
    "fastify": "5.11.2",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.3",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
