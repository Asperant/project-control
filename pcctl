#!/usr/bin/env bash
# =============================================================================
# pcctl — the single entry point for every Project Control operation.
#
#   ./pcctl <command> [options]
#   ./pcctl help
#
# Commands that modify the host (install, start, stop, update, uninstall, and
# the configure-* checkpoints) require root and say so rather than silently
# re-executing under sudo — an operator should always know when they are about
# to run something privileged.
# =============================================================================
set -Eeuo pipefail

PCCTL_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PC_REPO_ROOT="$PCCTL_DIR"

# shellcheck source=scripts/lib/common.sh
source "${PCCTL_DIR}/scripts/lib/common.sh"

usage() {
  cat >&2 <<'PCCTL_USAGE'
Project Control

USAGE
  ./pcctl <command> [options]

SETUP
  preflight              Inspect the host. Read-only; changes nothing.
  install                Create /srv/project-control, build images, start the stack.
  create-admin           Create the first administrator account (interactive).

LIFECYCLE
  start                  Start the container stack.
  stop                   Stop the container stack (data is preserved).
  restart                Restart the container stack.
  status                 Show container, runner and Tailscale status.
  health                 Probe every component and report.
  logs [service] [-f]    Show logs. Services: postgres db-bootstrap n8n control-api web caddy runner

MANUAL CHECKPOINTS
  configure-tailscale    Connect the tailnet and publish the portal (checkpoint 1).
  configure-google-drive Authorise rclone against Google Drive (checkpoint 2).
  configure-telegram     Store the bot token and chat id (checkpoint 3).

BACKUP
  backup [--check]       Run a backup now, or verify the repository.
  restore-test           Restore the latest snapshot into an isolated sandbox.

REPOSITORY ACTIONS
  enable-repo-writes <path>   Opt one registered project's .git into commit access.
  disable-repo-writes <path>  Revoke it. See docs/repository-actions.md.

SERVICE TOKENS
  create-service-token <key> [--ttl-days N]  Mint a scoped machine credential.
  list-service-tokens                        List every minted token.
  revoke-service-token <id>                  Revoke one. See docs/service-accounts.md.

AUTOMATION
  install-workflows       Import the shipped n8n workflows (checkpoint 5b, optional).

VERIFICATION
  verify [--json]        Full functional verification.
  verify-security [--json]  Security posture verification.
  release-manifest [--out FILE]
                          Read-only JSON manifest: version, git commit, image
                          digests, migration level, checkpoint-reader
                          capability, runner version, backup/security status.
                          See docs/release-checklist.md.

MAINTENANCE
  update                 Back up, pull pinned images, migrate, health-gate.
  rollback               Return to the previous version lock and images.
  reconcile-state        Repair deployment metadata to match an already
                         running, verified-coherent stack. Deploys nothing.
  recover-deployment     Forward-repair locally-built service(s) stuck in
                         Docker's 'created' state after a failed update, when
                         NOTHING is pending (schema already caught up).
                         Never touches postgres/n8n. See docs/update-rollback.md.
  resume-update          Complete an update interrupted before its pending
                         migration(s) were ever applied, when locally-built
                         service(s) are stuck 'created'. Never touches
                         postgres/n8n. See docs/update-rollback.md.
  uninstall              Remove the stack. Data is KEPT unless --delete-data.

ENVIRONMENT
  PC_ROOT                Deployment root (default: /srv/project-control)
  PC_DEBUG=1             Verbose script output
PCCTL_USAGE
}

run_script() {
  local script="${PCCTL_DIR}/scripts/$1"; shift
  [[ -f "$script" ]] || die "internal error: missing script $script"
  exec bash "$script" "$@"
}

require_root_for() {
  local command="$1"
  if ! is_root; then
    log_error "'${command}' modifies the host and must run as root."
    log_info  "run: sudo ./pcctl ${command}"
    exit 1
  fi
}

command="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "$command" in
  preflight)              run_script preflight.sh "$@" ;;

  install)                require_root_for install
                          run_script install.sh "$@" ;;

  start|stop|restart|status|health|logs)
                          run_script lifecycle.sh "$command" "$@" ;;

  create-admin)           run_script create-admin.sh "$@" ;;

  configure-tailscale)    require_root_for configure-tailscale
                          run_script configure-tailscale.sh "$@" ;;
  configure-google-drive) require_root_for configure-google-drive
                          run_script configure-google-drive.sh "$@" ;;
  configure-telegram)     require_root_for configure-telegram
                          run_script configure-telegram.sh "$@" ;;

  backup)                 require_root_for backup
                          run_script backup.sh "$@" ;;
  restore-test)           require_root_for restore-test
                          run_script restore-test.sh "$@" ;;

  enable-repo-writes)     require_root_for enable-repo-writes
                          run_script repo-writes.sh enable "$@" ;;
  disable-repo-writes)    require_root_for disable-repo-writes
                          run_script repo-writes.sh disable "$@" ;;

  create-service-token)   run_script service-tokens.sh create "$@" ;;
  list-service-tokens)    run_script service-tokens.sh list "$@" ;;
  revoke-service-token)   run_script service-tokens.sh revoke "$@" ;;

  install-workflows)      run_script install-workflows.sh "$@" ;;

  verify)                 run_script verify.sh "$@" ;;
  verify-security)        run_script verify-security.sh "$@" ;;
  release-manifest)       run_script release-manifest.sh "$@" ;;

  update)                 require_root_for update
                          run_script update.sh "$@" ;;
  rollback)               require_root_for rollback
                          run_script rollback.sh "$@" ;;
  reconcile-state)        require_root_for reconcile-state
                          run_script reconcile-state.sh "$@" ;;
  recover-deployment)     require_root_for recover-deployment
                          run_script recover-deployment.sh "$@" ;;
  resume-update)          require_root_for resume-update
                          run_script resume-update.sh "$@" ;;
  uninstall)              require_root_for uninstall
                          run_script uninstall.sh "$@" ;;

  # Undocumented but useful: build images without installing.
  build)                  run_script build.sh "$@" ;;

  help|--help|-h)         usage; exit 0 ;;
  version|--version|-v)   load_versions; printf 'project-control %s\n' "${PC_STACK_VERSION}"; exit 0 ;;

  *)  log_error "unknown command: ${command}"
      usage
      exit 1 ;;
esac
